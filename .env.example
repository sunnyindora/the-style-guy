# ============================================================================
# THE STYLE GUY - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# Database (PostgreSQL)
# Example for local: postgresql://postgres:password@localhost:5432/thestyleguy
# Example for Supabase/Neon/etc: Use your connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Next Auth
# Generate one with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-random-secret-key-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# Public Site URL (used for SEO/canonical links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================================================
# Affiliate Network Keys
# Replace with your real credentials when going live.
# ============================================================================

# Amazon Associates
AMAZON_AFFILIATE_TAG="yourtag-21"

# Flipkart Affiliate
FLIPKART_AFFILIATE_ID="your-flipkart-affiliate-id"
FLIPKART_AFFILIATE_TOKEN="your-flipkart-token"

# Cuelinks
CUELINKS_PUBLISHER_ID="your-cuelinks-publisher-id"

# EarnKaro
EARNKARO_AFFILIATE_ID="your-earnkaro-id"

# ============================================================================
# Optional: Analytics / Redis (for production caching)
# ============================================================================
# REDIS_URL="redis://localhost:6379"
# GA_MEASUREMENT_ID="G-XXXXXXXXXX"
