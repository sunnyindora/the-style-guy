// Prisma schema for THE STYLE GUY
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AffiliateSource {
  AMAZON
  FLIPKART
  CUELINKS
  EARNKARO
  MANUAL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  wishlists     Wishlist[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  image     String?
  parentId  String?
  parent    Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
}

model Product {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  brand              String
  categoryId         String
  category           Category        @relation(fields: [categoryId], references: [id])
  description        String          @db.Text
  price              Float
  originalPrice      Float
  discount           Float           @default(0)
  rating             Float           @default(0)
  reviewCount        Int             @default(0)
  image              String
  images             String[]        @default([])
  store              String
  source             AffiliateSource @default(MANUAL)
  affiliateUrl       String
  externalProductId  String?
  availability       Boolean         @default(true)
  sizes              String[]        @default([])
  colors             String[]        @default([])
  material           String?
  specifications     Json?
  pros               String[]        @default([])
  cons               String[]        @default([])
  styleRecommendation String?        @db.Text
  featured           Boolean         @default(false)
  trending           Boolean         @default(false)
  outfitProducts     OutfitProduct[]
  wishlists          Wishlist[]
  clicks             AffiliateClick[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([brand])
  @@index([featured, trending])
}

model Article {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  content        String   @db.Text
  excerpt        String
  featuredImage  String
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  author         String
  seoTitle       String?
  seoDescription String?
  published      Boolean  @default(false)
  readingTime    Int      @default(5)
  publishedAt    DateTime?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([slug])
  @@index([published])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Outfit {
  id          String          @id @default(cuid())
  name        String
  occasion    String
  description String?
  products    OutfitProduct[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([occasion])
}

model OutfitProduct {
  id        String   @id @default(cuid())
  outfitId  String
  productId String
  position  Int
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([outfitId])
}

model AffiliateClick {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  source      AffiliateSource
  sessionId   String?
  referrer    String?
  campaign    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime        @default(now())

  @@index([productId])
  @@index([timestamp])
  @@index([source])
}

model AffiliateSetting {
  id            String          @id @default(cuid())
  source        AffiliateSource @unique
  name          String
  affiliateId   String?
  apiKey        String?
  secretKey     String?
  campaignId    String?
  trackingParam String?
  active        Boolean         @default(false)
  baseUrl       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  sessionId String?
  results   Int      @default(0)
  timestamp DateTime @default(now())

  @@index([query])
  @@index([timestamp])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  sessionId String?
  referrer  String?
  duration  Int?
  timestamp DateTime @default(now())

  @@index([path])
  @@index([timestamp])
}
